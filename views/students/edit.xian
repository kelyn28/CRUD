
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Student</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: white;
            color: black;
            font-size: 13px;
            margin: 25px;
        }

        h2 {
            font-size: 18px;
            font-weight: normal;
        }

        p {
            margin: 12px 0;
        }

        input {
            margin-left: 5px;
        }
    </style>
</head>
<body>

    <h2>Edit Student</h2>

    <form action="/students/edit/{{student.id}}" method="POST">
        <p>
            First Name:
            <input type="text" name="firstName"
                   value="{{student.firstName}}" required>
        </p>

        <p>
            Last Name:
            <input type="text" name="lastName"
                   value="{{student.lastName}}" required>
        </p>

        <p>
            Age:
            <input type="number" name="age" min="1" max="120"
                   value="{{student.age}}" required>
        </p>

        <p>
            Gender:
            <input type="text" name="gender"
                   value="{{student.gender}}" required>
        </p>

        <p>
            Type:
            <input type="text" name="type"
                   value="{{student.type}}">
        </p>

        <p>
            ZIP:
            <input type="text" name="zip"
                   value="{{student.zip}}">
        </p>

        <p>
            Address:
            <input type="text" name="address"
                   value="{{student.address}}">
        </p>

        <button type="submit">Save Changes</button>
        <a href="/students/insert">Cancel</a>
    </form>

</body>
</html>
